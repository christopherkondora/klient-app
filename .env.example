# Supabase Configuration
# Create a project at https://supabase.com and copy these values from Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (get from Stripe dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billingo (get from Billingo dashboard → Beállítások → API)
BILLINGO_API_KEY=

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=
# OpenAI (AI features)
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Apple code signing & notarization (macOS builds only)
# ─────────────────────────────────────────────────────────────
# Apple ID email of the Developer Program account
APPLE_ID=
# App-specific password generated at appleid.apple.com → Sign-In and Security
# Format: xxxx-xxxx-xxxx-xxxx (NOT your Apple ID password)
APPLE_APP_SPECIFIC_PASSWORD=
# 10-character Team ID from developer.apple.com → Membership
APPLE_TEAM_ID=
# Path to the "Developer ID Application" .p12 cert (forward slashes; macOS path or file:// URL)
# Place the .p12 in build/certs/ which is gitignored.
CSC_LINK=build/certs/DeveloperIDApplication.p12
# Export password for the .p12 file
CSC_KEY_PASSWORD=
