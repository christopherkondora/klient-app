# Supabase Configuration
# Create a project at https://supabase.com and copy these values from Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Stripe (get from Stripe dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Billingo (get from Billingo dashboard → Beállítások → API)
BILLINGO_API_KEY=

# Deepgram (speech-to-text)
DEEPGRAM_API_KEY=
# OpenAI (AI features)
OPENAI_API_KEY=
