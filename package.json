{
  "name": "klient",
  "version": "1.1.1",
  "description": "Business management system for marketing agencies and freelancers",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev:react": "vite",
    "dev:electron:build": "npx tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-electron/electron/main.js dist-electron/electron/preload.js && nodemon --watch dist-electron --delay 150ms --ext js --exec \"electron .\"",
    "dev": "concurrently -k \"npm run dev:react\" \"npm run dev:electron:build\" \"npm run dev:electron\"",
    "build:react": "npx tsc && vite build",
    "build:electron": "npx tsc -p tsconfig.electron.json",
    "build": "npm run build:react && npm run build:electron",
    "pack": "npm run build && electron-builder --dir -c electron-builder.config.cjs",
    "dist": "npm run build && electron-builder -c electron-builder.config.cjs",
    "dist:mac": "npm run build && dotenv -- electron-builder --mac -c electron-builder.config.cjs",
    "dist:win": "npm run build && electron-builder --win -c electron-builder.config.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "business",
    "management",
    "marketing",
    "freelancer",
    "agency"
  ],
  "author": {
    "name": "Kondora Kristóf Máté Egyéni Vállalkozó"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14",
    "supabase": "^2.84.5",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.99.3",
    "@tiptap/extension-bubble-menu": "^3.20.1",
    "@tiptap/extension-highlight": "^3.20.1",
    "@tiptap/extension-image": "^3.20.4",
    "@tiptap/extension-link": "^3.20.4",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-text-align": "^3.20.4",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/react": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.1",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.11"
  }
}
